# ---- dependencies ----
node_modules/
.npm/
*.tgz

# ---- build output ----
dist/
build/
*.tsbuildinfo

# ---- secrets & local config ----
.env
.env.*
!.env.example

# ---- Playwright ----
/framework/playwright-report/
/framework/test-results/
/framework/blob-report/
/framework/.auth/
/framework/playwright/.cache/

# ---- Allure ----
allure-results/
allure-report/
.allure/

# ---- orchestrator run artifacts (real runs are local; /examples holds a committed sample) ----
/orchestrator/runs/*
!/orchestrator/runs/.gitkeep

# ---- editors & OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- logs ----
*.log
npm-debug.log*
logs/
