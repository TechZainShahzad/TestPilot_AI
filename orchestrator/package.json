{
  "name": "@testpilot/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent orchestrator that explores an app, plans tests, generates Playwright code, runs it, heals failures, reviews the result and opens a pull request.",
  "bin": {
    "testpilot": "./dist/cli.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc --build",
    "dev": "tsx watch src/cli.ts"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "dotenv": "^18.0.5",
    "groq-sdk": "^1.6.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.23.15"
  }
}
