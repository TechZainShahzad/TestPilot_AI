{
  "name": "testpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-orchestrated Playwright automation framework: a production-grade test suite for the SauceDemo e-commerce app, plus a multi-agent orchestrator that writes, runs, heals and reviews the tests.",
  "license": "MIT",
  "author": "Muhammad Zain Shahzad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechZainShahzad/TestPilot_AI.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "framework",
    "orchestrator"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --verbose",
    "test": "npm run test --workspace=framework",
    "test:smoke": "npm run test:smoke --workspace=framework",
    "test:regression": "npm run test:regression --workspace=framework",
    "test:guest": "npm run test:guest --workspace=framework",
    "report": "npm run report --workspace=framework",
    "allure:generate": "npm run allure:generate --workspace=framework",
    "allure:open": "npm run allure:open --workspace=framework",
    "orchestrate": "npm run start --workspace=orchestrator --",
    "verify": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
