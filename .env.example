# =============================================================================
# TestPilot_AI — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
#   cp .env.example .env
# Every value below has a safe default in code except the API keys, so the
# Playwright suite runs with no .env at all. Only the orchestrator needs keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Target application (SauceDemo public demo)
# -----------------------------------------------------------------------------
# Which environment block to use. One of: demo | local
TEST_ENV=demo

# Base URL of the app under test.
BASE_URL=https://www.saucedemo.com

# -----------------------------------------------------------------------------
# Test identity
# -----------------------------------------------------------------------------
# SauceDemo has no registration — every account is one of its fixed demo
# logins, all sharing the password "secret_sauce". The `setup` project logs
# in as this account once and every `ui` spec reuses that session. Override
# to run the suite as one of the deliberately-broken variants instead
# (problem_user, performance_glitch_user, error_user, visual_user,
# locked_out_user — locked_out_user will fail setup by design).
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# -----------------------------------------------------------------------------
# Playwright run tuning
# -----------------------------------------------------------------------------
# Headed browser + slow motion for debugging. CI always runs headless.
HEADLESS=true
SLOW_MO=0

# Per-action and per-navigation timeouts, in milliseconds.
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=45000

# Worker count. Leave blank to let Playwright decide (CI pins this to 2).
WORKERS=

# Retry count for locally run tests. CI uses 2.
RETRIES=0

# -----------------------------------------------------------------------------
# Orchestrator — LLM provider
# -----------------------------------------------------------------------------
# Which provider the agents talk to. One of: gemini | groq
LLM_PROVIDER=gemini

# Google AI Studio key — https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud key — https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# Orchestrator — run limits (guardrails; the run aborts when exceeded)
# -----------------------------------------------------------------------------
MAX_HEAL_ATTEMPTS=3
MAX_REVIEW_ROUNDS=2
MAX_TOKENS_PER_RUN=400000
MAX_USD_PER_RUN=1.00
AGENT_STEP_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# Orchestrator — pull request creation
# -----------------------------------------------------------------------------
# Fine-grained PAT with Contents:write + Pull requests:write on this repo.
# Create at https://github.com/settings/personal-access-tokens
# Leave blank to force --dry-run behaviour (plan + generate, no PR).
GITHUB_TOKEN=
GITHUB_REPO=TechZainShahzad/TestPilot_AI
GITHUB_BASE_BRANCH=main
